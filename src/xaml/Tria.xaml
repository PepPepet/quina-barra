<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quina Barra!" Width="480" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    @ESTILS@
    <Style TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="12,7" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="@HOVER@"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="@SEL@"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="@BG@" CornerRadius="8" BorderBrush="@BORDER@" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/></Border.Effect>
    <Grid Margin="24,18,24,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="Capcalera" Grid.Row="0" Background="Transparent">
        <TextBlock Text="Tria la ubicació" FontSize="20" FontWeight="SemiBold" Foreground="@FG@" VerticalAlignment="Center"/>
        <Button x:Name="BTanca" Style="{StaticResource Pla}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Right" Padding="10,8"/>
      </Grid>
      <TextBlock Grid.Row="1" Margin="0,6,0,16" TextWrapping="Wrap" Foreground="@SUB@" FontSize="13"
                 Text="Escriu el teu poble, ciutat o barri. Tu tries on ets: no fem servir la teva connexió per endevinar-ho."/>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="CaixaCerca" Background="@CARD@" BorderBrush="@BORDER@" BorderThickness="1" CornerRadius="5" Height="36">
          <Grid>
            <TextBlock x:Name="Pista" Text="Per exemple: Ripoll, Amposta, Gràcia..." Foreground="@SUB@" Opacity="0.7" FontSize="14" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="TCerca" Background="Transparent" BorderThickness="0" Foreground="@FG@" CaretBrush="@FG@" FontSize="14" Padding="9,0" VerticalContentAlignment="Center"/>
          </Grid>
        </Border>
        <Button x:Name="BCerca" Grid.Column="1" Style="{StaticResource Accent}" Content="Cerca" Margin="8,0,0,0" Height="36" Padding="18,0"/>
      </Grid>

      <TextBlock x:Name="Estat" Grid.Row="3" Margin="2,12,0,6" Foreground="@SUB@" FontSize="12" Text="Resultats"/>
      <Border Grid.Row="4" Background="@CARD@" BorderBrush="@BORDER@" BorderThickness="1" CornerRadius="6" Padding="4" Height="230">
        <ListBox x:Name="Llista" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      </Border>

      <TextBlock Grid.Row="5" Margin="2,16,0,6" Foreground="@SUB@" FontSize="12" Text="Nom que vols veure a la barra"/>
      <Border Grid.Row="6" Background="@CARD@" BorderBrush="@BORDER@" BorderThickness="1" CornerRadius="5" Height="36">
        <TextBox x:Name="TNom" Background="Transparent" BorderThickness="0" Foreground="@FG@" CaretBrush="@FG@" FontSize="14" Padding="9,0" VerticalContentAlignment="Center"/>
      </Border>

      <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="BCancela" Content="Cancel·la" MinWidth="110"/>
        <Button x:Name="BDesa" Style="{StaticResource Accent}" Content="Desa" MinWidth="110" Margin="8,0,0,0" IsEnabled="False"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
